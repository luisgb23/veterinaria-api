# Copiá este archivo como ".env" y ajustá los valores a tu entorno.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=itapebi
DB_USER=root
DB_PASS=

# true muestra el mensaje real de los errores 500 (usar solo en desarrollo)
APP_DEBUG=true

# Zona horaria de las fechas de creación/modificación
APP_TIMEZONE=America/Montevideo

# Origen permitido para CORS ("*" permite cualquiera; en producción poné tu dominio)
CORS_ALLOWED_ORIGIN=*

# Solo si la API corre dentro de una subcarpeta del servidor (ej: /mi-api). Vacío con php -S.
APP_BASE_PATH=

# --- Autenticación JWT ---
# OBLIGATORIO: clave secreta de al menos 32 caracteres. Generá una con:
#   php -r "echo bin2hex(random_bytes(32));"
# Nunca la subas a Git ni la compartas: quien la tenga puede fabricar tokens válidos.
JWT_SECRET=

# Vida del access token en segundos (3600 = 1 hora)
JWT_TTL=3600

# Vida del refresh token en segundos (2592000 = 30 días)
REFRESH_TTL=2592000

# --- Archivos adjuntos de las consultas ---
# Tamaño máximo por archivo en MB (también revisá upload_max_filesize y post_max_size en php.ini)
UPLOAD_MAX_MB=10
